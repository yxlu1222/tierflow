[Unit]
Description=TierFlow Qwen3.8-27B NVFP4 + DSpark inference service (SGLang)
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service
Conflicts=tierflow-model-ling30-tiny.service tierflow-model-nemotron35-lightning.service tierflow-model-lfm25.service

[Service]
Type=simple
EnvironmentFile=/etc/tierflow/model-bind.env
ExecStartPre=-/usr/bin/docker rm -f tierflow-model-qwen38-nvfp4
ExecStart=/usr/bin/docker run --rm \
  --name tierflow-model-qwen38-nvfp4 \
  --gpus all \
  --network host \
  --ipc host \
  --shm-size 16g \
  --memory 100g \
  --memory-swap 100g \
  --ulimit memlock=-1 \
  --ulimit stack=67108864 \
  --stop-timeout 120 \
  -e HF_HUB_OFFLINE=1 \
  -e TRANSFORMERS_OFFLINE=1 \
  -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
  -e TORCHINDUCTOR_CACHE_DIR=/cache/inductor \
  -v /var/lib/tierflow/models/qwen3.8-27b-nvfp4:/model:ro \
  -v /var/lib/tierflow/models/qwen3.8-27b-dspark:/draft:ro \
  -v /var/cache/tierflow-sglang:/root/.cache/sglang \
  -v /var/cache/tierflow-sglang:/cache \
  lmsysorg/sglang:qwen38-27b \
  sglang serve \
  --trust-remote-code \
  --model-path /model \
  --served-model-name Qwen3.8-27B \
  --context-length 262144 \
  --mem-fraction-static 0.50 \
  --attention-backend flashinfer \
  --chunked-prefill-size 8192 \
  --disable-prefill-cuda-graph \
  --cuda-graph-max-bs 4 \
  --speculative-algorithm DSPARK \
  --speculative-draft-model-path /draft \
  --speculative-dspark-block-size 7 \
  --speculative-draft-model-quantization unquant \
  --mamba-radix-cache-strategy extra_buffer_lazy \
  --mamba-ssm-dtype bfloat16 \
  --max-mamba-cache-size 96 \
  --max-running-requests 8 \
  --enable-torch-compile \
  --torch-compile-max-bs 4 \
  --num-continuous-decode-steps 2 \
  --mm-feature-transport cpu \
  --reasoning-parser qwen3 \
  --tool-call-parser qwen3_coder \
  --enable-metrics \
  --host ${TIERFLOW_MODEL_BIND_IP} \
  --port 8102
ExecStop=-/usr/bin/docker stop -t 120 tierflow-model-qwen38-nvfp4
Restart=on-failure
RestartSec=15
TimeoutStartSec=3600
TimeoutStopSec=180
KillMode=process
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
