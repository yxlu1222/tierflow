[Unit]
Description=TierFlow Ling-3.0-tiny balanced co-host service for Nemotron-3.5-Lightning
Wants=network-online.target
Requires=docker.service tierflow-model-nemotron35-lightning.service
After=network-online.target docker.service tierflow-model-nemotron35-lightning.service
Conflicts=tierflow-model-qwen38.service tierflow-model-lfm25.service tierflow-model-lfm25-cohost.service tierflow-model-nanbeige42.service tierflow-model-deepseek-v4-flash.service

[Service]
Type=simple
EnvironmentFile=/etc/tierflow/model-bind.env
ExecStartPre=-/usr/bin/docker rm -f tierflow-model-ling30-tiny
ExecStartPre=/usr/local/sbin/tierflow-wait-model-ready tierflow-model-nemotron35-lightning.service http://${TIERFLOW_MODEL_BIND_IP}:8104/v1/models 1800
ExecStart=/usr/bin/docker run --rm \
  --name tierflow-model-ling30-tiny \
  --gpus all \
  --network host \
  --ipc host \
  --shm-size 16g \
  --memory 110g \
  --memory-swap 110g \
  --ulimit memlock=-1 \
  --ulimit stack=67108864 \
  --stop-timeout 120 \
  -e HF_HUB_OFFLINE=1 \
  -e TRANSFORMERS_OFFLINE=1 \
  -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
  -e TORCHINDUCTOR_CACHE_DIR=/cache/inductor \
  -v /var/lib/tierflow/models/ling-3.0-tiny-fp8:/model:ro \
  -v /var/cache/tierflow-sglang:/root/.cache/sglang \
  -v /var/cache/tierflow-sglang:/cache \
  tierflow/sglang-ling30:spark-fix1 \
  python3 -m sglang.launch_server \
  --trust-remote-code \
  --model-path /model \
  --served-model-name Ling-3.0-tiny \
  --context-length 131072 \
  --mem-fraction-static 0.53 \
  --max-running-requests 8 \
  --fp8-gemm-backend triton \
  --moe-runner-backend triton \
  --bf16-gemm-backend torch \
  --reasoning-parser ling3 \
  --tool-call-parser ling3 \
  --enable-metrics \
  --host ${TIERFLOW_MODEL_BIND_IP} \
  --port 8106
ExecStop=-/usr/bin/docker stop -t 120 tierflow-model-ling30-tiny
Restart=on-failure
RestartSec=15
TimeoutStartSec=3600
TimeoutStopSec=180
KillMode=process
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
