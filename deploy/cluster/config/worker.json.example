{
  "node_name": "spark-worker-01",
  "role": "worker",
  "listen": "192.168.200.2:9020",
  "advertise_url": "http://192.168.200.2:9020",
  "controller_url": "http://192.168.200.1:3000/api/cluster/heartbeat",
  "token_file": "/etc/tierflow/cluster-agent.token",
  "state_file": "/var/lib/tierflow/node-agent-state.json",
  "disk_path": "/var/lib/tierflow",
  "heartbeat_interval_seconds": 10,
  "command_timeout_seconds": 30,
  "models": [
