# TierFlow (new-api fork) 部署环境变量
# 用法: cp .env.tierflow.example .env  然后按需修改
# 密码请用字母数字(避免 @ : / 等会破坏 SQL_DSN / Redis URL 的字符)

# 对外端口
PORT=3000

# ── 镜像 ──
# 生产建议跑「stable 发布频道」(只在打 v* tag 时移动)。换 owner / tag 在此改。
# 私有镜像需先在部署机 docker login ghcr.io。
TIERFLOW_IMAGE=ghcr.io/zer0echo/tierflow-api:stable

# 会话密钥(cookie 签名)，务必改成随机串：  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string

# ── 数据库 / 缓存(默认 MySQL + Redis) ──
DB_PASSWORD=change-me-db
REDIS_PASSWORD=change-me-redis

# ── infer 推理服务(独立 GPU 机器) ──
# 指向 infer 机器的地址；留空则 auto 路由不打分、直接走 tier3 兜底。
# 也可以不填这里，登录后在「系统设置 → 模型设置 → 推理服务」里配(优先于本 env)。
INFERENCE_SERVICE_URL=http://<infer-机器IP>:8001
INFERENCE_SERVICE_SECRET=<和 infer 启动时的 INFERENCE_SERVICE_SECRET 一致>
INFERENCE_SERVICE_TIMEOUT_MS=10000

TZ=Asia/Shanghai

# ── 一键更新(后台「检查更新」按钮)──
# check 取此仓库最新 release tag 与当前版本比较;perform 触发 watchtower 拉最新 :stable 重建。
UPDATE_REPO=Zer0Echo/tierflow-core
# 私有仓库或避免 GitHub 限流时填一个有 repo 读权限的 PAT;公开库可留空。
UPDATE_GITHUB_TOKEN=
# watchtower HTTP API token,务必改成随机串(和 watchtower 容器内一致,compose 已用同一个变量)。
WATCHTOWER_TOKEN=change-me-to-a-random-string

# 构建镜像时的 Go 模块代理；国内/代理网络连不上官方源时改成 goproxy.cn
GOPROXY=https://proxy.golang.org,direct
